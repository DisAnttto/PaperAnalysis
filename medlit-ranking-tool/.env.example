# ── LLM / AI ──────────────────────────────────────────────────────────────────
# One active backend: default (LLM_*) or NVIDIA NIM (Kimi, etc.)
LLM_BACKEND=default

# Qwen via DashScope (default backend)
LLM_API_KEY=sk-81a9786ff5a74c72b9f799c954972c49
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# NVIDIA NIM — Kimi (set LLM_BACKEND=nvidia_nim and add your nvapi- key from build.nvidia.com)
# LLM_BACKEND=nvidia_nim
# NVIDIA_NIM_API_KEY=nvapi-your-key-here
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# OpenAI / OpenRouter (default backend: leave LLM_BACKEND=default)
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ── PubMed / NCBI ─────────────────────────────────────────────────────────────
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/medlit.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# APP_MODE: "demo" = seeded fixtures, no LLM/PubMed calls (default for local QA)
#           "dev"  = live pipeline (requires LLM_API_KEY and NCBI_EMAIL)
APP_MODE=demo
LOG_LEVEL=INFO
